#!/usr/bin/python3
"""Run Axia DE with Fedora's user bus and an independent polkit agent."""
import json
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import threading
import time


def sockets(runtime):
    found = set()
    for path in runtime.glob('wayland-*'):
        try:
            if stat.S_ISSOCK(path.stat().st_mode):
                found.add(path.name)
        except OSError:
            pass  # A different compositor can remove its socket while we list it.
    return found


def theme_args(env, root):
    # Load the selected theme directly instead of parsing default and then
    # throwing away its JS context when startShell requests the saved theme.
    home = Path(env.get('HOME') or Path.home())
    # Match lord.settings (server/src/ui/js_sys.c), which currently uses HOME.
    config = home / '.config'
    try:
        with (config / 'axia/settings.json').open() as stream:
            prefs = json.loads(stream.read(1024 * 1024 + 1))
        name = prefs.get('theme') if isinstance(prefs, dict) else None
        if isinstance(name, str) and re.fullmatch(r'[A-Za-z0-9_-]{1,64}', name):
            bundle = root / 'themes' / name / 'theme.bundle.js'
            if bundle.is_file() and os.access(bundle, os.R_OK):
                return ['--theme', str(bundle)]
    except (OSError, ValueError):
        pass
    return []


def session_log(env):
    home = Path(env.get('HOME') or Path.home())
    cache = Path(env.get('XDG_CACHE_HOME') or home / '.cache')
    path = cache / 'axia/session.log'
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if path.exists():
            path.replace(path.with_name('session.previous.log'))
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
        return os.fdopen(fd, 'w', buffering=1)
    except OSError as error:
        print(f'Axia: could not open session log: {error}', file=sys.stderr)
        return None


def publish_environment(env, wayland, display):
    env['WAYLAND_DISPLAY'] = wayland
    env['DISPLAY'] = display
    names = ['DISPLAY', 'WAYLAND_DISPLAY', 'XDG_CURRENT_DESKTOP', 'XDG_SESSION_DESKTOP',
             'XDG_SESSION_TYPE', 'GDK_BACKEND', 'MOZ_ENABLE_WAYLAND', 'GTK_USE_PORTAL']
    try:
        subprocess.run(['dbus-update-activation-environment', '--systemd', *names],
                       env=env, check=False, timeout=10)
    except (OSError, subprocess.SubprocessError) as error:
        print(f'Axia: could not publish session environment: {error}', file=sys.stderr)


def executable_replaced(pid):
    try:
        executable = Path(f'/proc/{pid}/exe')
        target = os.readlink(executable)
        if not target.endswith(' (deleted)'):
            return False
        running = executable.stat()
        installed = Path(target[:-len(' (deleted)')]).stat()
        return (running.st_dev, running.st_ino) != (installed.st_dev, installed.st_ino)
    except OSError:
        return False


def watch_updates(server, env, log, stopped):
    while not stopped.wait(30):
        if server.poll() is not None:
            return
        if executable_replaced(server.pid):
            print('Axia: the running executable was replaced; log out and back in to use the installed build.',
                  file=log or sys.stderr, flush=True)
            language = (env.get('LC_ALL') or env.get('LC_MESSAGES') or env.get('LANG') or 'en')[:2]
            messages = {
                'pt': ('Axia DE foi atualizado', 'Salve seu trabalho e saia e entre na sessão para usar a versão instalada.'),
                'es': ('Axia DE se ha actualizado', 'Guarda tu trabajo y cierra e inicia sesión para usar la versión instalada.'),
                'en': ('Axia DE was updated', 'Save your work and log out and back in to use the installed version.'),
            }
            title, body = messages.get(language, messages['en'])
            try:
                subprocess.run(['notify-send', '--app-name=Axia DE', '--icon=system-software-update',
                                title, body], env=env, check=False, timeout=3,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError):
                pass  # Logging and the desktop still work without libnotify.
            return


def wait_for_session(server, env, log):
    stopped = threading.Event()
    watcher = threading.Thread(target=watch_updates, args=(server, env, log, stopped), daemon=True)
    watcher.start()
    try:
        return server.wait()
    finally:
        stopped.set()
        watcher.join(timeout=4)


def x_display(pid):
    # Axia DE reserves an Xwayland socket before starting Xwayland on demand.
    # Match its lock to this compositor, rather than guessing a display number.
    for lock in Path('/tmp').glob('.X*-lock'):
        try:
            number = lock.name[2:-5]
            sock = Path('/tmp/.X11-unix') / f'X{number}'
            if (number.isdigit() and lock.stat().st_uid == os.getuid()
                    and int(lock.read_text().strip()) == pid
                    and sock.stat().st_uid == os.getuid()
                    and stat.S_ISSOCK(sock.stat().st_mode)):
                return f':{number}'
        except (OSError, ValueError):
            continue
    return ''


def initialize_user_dirs(env):
    # The Fedora session does not run GNOME's autostart entries. Initialize the
    # standard folders once, using the host's locale and defaults. Existing XDG
    # choices (including deliberately disabled folders) are left untouched.
    home = Path(env.get('HOME') or Path.home())
    config = Path(env.get('XDG_CONFIG_HOME') or home / '.config')
    if (config / 'user-dirs.dirs').exists():
        return
    try:
        # Keep folders already populated by other desktops instead of creating
        # empty translated counterparts (e.g. Music beside Músicas).
        existing = {
            'DESKTOP': ['Área de trabalho', 'Área de Trabalho', 'Desktop', 'Escritorio'],
            'DOWNLOAD': ['Downloads', 'Descargas', 'Transferências'],
            'DOCUMENTS': ['Documentos', 'Documents'],
            'PICTURES': ['Imagens', 'Pictures', 'Imágenes'],
            'MUSIC': ['Músicas', 'Música', 'Music'],
            'VIDEOS': ['Vídeos', 'Videos'],
        }
        config.mkdir(parents=True, exist_ok=True)
        for key, names in existing.items():
            path = next((home / name for name in names if (home / name).is_dir()), None)
            if path:
                subprocess.run(['xdg-user-dirs-update', '--set', key, str(path)],
                               env=env, check=True, timeout=10)
        subprocess.run(['xdg-user-dirs-update'], env=env, check=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as error:
        print(f'Axia: could not initialize standard user folders: {error}', file=sys.stderr)


def main():
    if os.geteuid() == 0:
        raise SystemExit('Start Axia DE as a regular user.')
    if not os.environ.get('DBUS_SESSION_BUS_ADDRESS'):
        os.execvp('dbus-run-session', ['dbus-run-session', '--', __file__])
    runtime = Path(os.environ['XDG_RUNTIME_DIR'])
    before = sockets(runtime)
    env = dict(os.environ, XDG_CURRENT_DESKTOP='Axia', XDG_SESSION_DESKTOP='axia',
               XDG_SESSION_TYPE='wayland', GDK_BACKEND='wayland', MOZ_ENABLE_WAYLAND='1',
               DISPLAY='', GTK_USE_PORTAL='1')
    initialize_user_dirs(env)
    log = session_log(env)
    try:
        server = subprocess.Popen(['@BINDIR@/axia-session', *theme_args(env, Path(__file__).resolve().parent)],
                                  env=env, stdout=log, stderr=log)
    except BaseException:
        if log:
            log.close()
        raise
    helpers = []

    def stop(signum, frame):
        if server.poll() is None:
            server.send_signal(signum)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        for _ in range(200):
            if server.poll() is not None:
                return server.returncode
            new = sockets(runtime) - before
            display = x_display(server.pid)
            if new:
                # Xwayland is optional. A native Wayland session must publish
                # its environment and start its polkit agent without it.
                publish_environment(env, sorted(new)[0], display)
                agent = '/usr/libexec/polkit-mate-authentication-agent-1'
                if Path(agent).is_file():
                    try:
                        helpers.append(subprocess.Popen([agent], env=env))
                    except OSError as error:
                        print(f'Axia: could not start polkit agent: {error}', file=log or sys.stderr)
                break
            time.sleep(0.1)
        return wait_for_session(server, env, log)
    finally:
        for child in helpers:
            if child.poll() is None:
                child.terminate()
                try:
                    child.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait()
        if log:
            log.close()


if __name__ == '__main__':
    raise SystemExit(main())
